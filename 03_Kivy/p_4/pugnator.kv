<incrementador>:
    orientation:'vertical'
    Button:
        id: button
        text: 'Incrementador'
        font_size:30
        on_release: label.text = str(int(label.text)+1)
        on_release: button.text = button.text + " Mais um"

    Label:
        id:label
        text: '1'
        font_size:30
        